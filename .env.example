# Copier ce fichier en .env puis remplir les valeurs (ne jamais le mettre sur GitHub)

# Dossier de configuration psacc existant sur la VM (identifiants MyOpel, OTP, limite de charge)
PSACC_CONFIG=/home/opc/psacc

# Image de l'appli publiée par GitHub Actions
APP_IMAGE=ghcr.io/aplaideau/corsa-app:latest

# VIN (optionnel) : laissé vide, il est détecté automatiquement depuis ton compte MyOpel
VIN=

# Identifiant de connexion
APP_USER=alexandre

# Mot de passe chiffré : générer avec
#   docker run --rm ghcr.io/aplaideau/corsa-app:latest node hash.js 'MonMotDePasse'
# puis coller la ligne obtenue ici (garder les apostrophes)
APP_PASSWORD_HASH='$2a$12$remplacer_par_le_hash'

# Clé secrète des sessions : générer avec  openssl rand -hex 32
SESSION_SECRET=remplacer_par_une_longue_cle_aleatoire
