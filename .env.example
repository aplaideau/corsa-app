# Copier ce fichier en .env puis remplir les valeurs (ne jamais le mettre sur GitHub)

# Dossier de configuration psacc existant sur la VM (identifiants MyOpel, OTP, limite de charge)
PSACC_CONFIG=/home/opc/psacc

# Image de l'appli publiée par GitHub Actions
APP_IMAGE=ghcr.io/aplaideau/corsa-app:latest

# VIN (optionnel) : laissé vide, il est détecté automatiquement depuis ton compte MyOpel
VIN=

# Identifiant de connexion
APP_USER=alexandre

# Mot de passe chiffré : générer avec
#   docker run --rm ghcr.io/aplaideau/corsa-app:latest node hash.js 'MonMotDePasse'
# puis coller la ligne obtenue ici (garder les apostrophes)
APP_PASSWORD_HASH='$2a$12$remplacer_par_le_hash'

# Clé secrète des sessions : générer avec  openssl rand -hex 32
SESSION_SECRET=remplacer_par_une_longue_cle_aleatoire

# Page « Ouvrir / fermer » de la voiture dans l'espace propriétaire Getaround (menu Options de l'appli)
GETAROUND_URL=https://fr.be.getaround.com/dashboard/cars/1433374/open_management

# Mode location automatique : boîte Gmail dédiée qui reçoit (filtre de transfert) les e-mails Getaround.
# Mot de passe d'application Google (16 lettres), PAS le mot de passe du compte. Laisser vide pour désactiver.
MAIL_USER=
MAIL_APP_PASSWORD=

# Adresse de contact pour les notifications (exigée par Apple). Par défaut : MAIL_USER.
VAPID_SUBJECT=

# Batterie en direct dans l'ABRP du locataire (QR code dans la voiture). Vide = désactivé.
# Jeton secret de l'adresse publique (au moins 12 caractères)
PUBLIC_SHARE_TOKEN=
# Adresse publique publiée par : sudo tailscale funnel --bg --https=8443 http://127.0.0.1:8081
PUBLIC_BASE_URL=https://<machine>.<tailnet>.ts.net:8443
# Clé API Telemetry (gratuite) : https://abetterrouteplanner.com/home/app/api-keys/telemetry
ABRP_API_KEY=
# Identifiant OAuth de l'application ABRP (si l'inscription OAuth est accordée ; sinon jeton collé à la main)
ABRP_CLIENT_ID=
